{
  "manifest_version": 3,
  "name": "Loupe",
  "version": "0.1.0",
  "description": "Clique sur une image, une vidéo, un texte ou un bloc d’une page pour savoir d’où il vient, ce qu’il pèse et comment il est fait, puis le télécharger.",
  "permissions": ["activeTab", "scripting", "downloads"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Loupe",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "aim": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "Prendre la loupe sur la page affichée"
    }
  }
}
